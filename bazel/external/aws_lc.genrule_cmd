#!/usr/bin/env bash

set -e

OS=`uname`
ARCH=`uname -m`

if [[ "$OS" != "Linux" || ("$ARCH" != "x86_64" && "$ARCH" != "aarch64" && "$ARCH" != "ppc64le") ]]; then
    echo "ERROR: AWS-LC FIPS is currently supported only on Linux-x86_64, Linux-ppc64le, and Linux-aarch64."
    exit 1
fi

# Get sysroot from first argument
if [[ -n "$1" && "$1" == */sysroot_linux_*/WORKSPACE ]]; then
  SYSROOT="$(cd $(dirname "$1") && pwd)"
  shift
fi

# Bazel magic
ROOT=./external
pushd "$ROOT"

# Use Envoy toolchain
export HOME="$PWD"
printf "set(CMAKE_C_COMPILER \"${CC}\")\\nset(CMAKE_CXX_COMPILER \"${CC}\")\\n" > "${HOME}/toolchain"

# Go
VERSION=1.18.1
if [[ "$ARCH" == "x86_64" ]]; then
    PLATFORM="linux-amd64"
    SHA256=b3b815f47ababac13810fc6021eb73d65478e0b2db4b09d348eefad9581a2334
else
    PLATFORM="linux-arm64"
    SHA256=56a91851c97fb4697077abbca38860f735c32b38993ff79b088dac46e4735633
fi

curl -sLO https://go.dev/dl/go"$VERSION"."$PLATFORM".tar.gz \
  && echo "$SHA256" go"$VERSION"."$PLATFORM".tar.gz | sha256sum --check
tar -xf go"$VERSION"."$PLATFORM".tar.gz
export PATH="$PWD/go/bin:$PATH"
export GOROOT="$PWD/go"

# Ninja
VERSION=1.13.2
curl -sLO https://github.com/ninja-build/ninja/archive/refs/tags/v"$VERSION".tar.gz \
  && echo "974d6b2f4eeefa25625d34da3cb36bdcebe7fbce40f4c16ac0835fd1c0cbae17" v"$VERSION".tar.gz | sha256sum --check
tar -xf v"$VERSION".tar.gz
cd ninja-"$VERSION"
unset CXXFLAGS LDFLAGS
export LDFLAGS="-lstdc++"
CXX="${CC}" python3 ./configure.py --bootstrap
export PATH="$PWD:$PATH"
cd ..

# CMake
VERSION=3.22.1
if [[ "$ARCH" == "x86_64" ]]; then
    PLATFORM="linux-x86_64"
    SHA256=73565c72355c6652e9db149249af36bcab44d9d478c5546fd926e69ad6b43640
else
    PLATFORM="linux-aarch64"
    SHA256=601443375aa1a48a1a076bda7e3cca73af88400463e166fffc3e1da3ce03540b
fi

curl -sLO https://github.com/Kitware/CMake/releases/download/v"$VERSION"/cmake-"$VERSION"-"$PLATFORM".tar.gz \
    && echo "$SHA256" cmake-"$VERSION"-"$PLATFORM".tar.gz | sha256sum --check
tar xf cmake-"$VERSION"-"$PLATFORM".tar.gz
export PATH="$PWD/cmake-$VERSION-$PLATFORM/bin:$PATH"

# Build AWS-LC
cd aws_lc

# Set sysroot flags
export CFLAGS="--sysroot=${SYSROOT} -fPIC"
export CXXFLAGS="-stdlib=libc++ --sysroot=${SYSROOT} -fPIC"
export LDFLAGS="-fuse-ld=lld -stdlib=libc++ -l:libc++.a -l:libc++abi.a -lm -pthread --sysroot=${SYSROOT}"

mkdir build && cd build
cmake -GNinja -DCMAKE_TOOLCHAIN_FILE=${HOME}/toolchain -DFIPS=1 -DCMAKE_BUILD_TYPE=Release ..
ninja

export GTEST_FILTER="-SSLTest.HostMatching"
./crypto/crypto_test

popd

# Copy libraries
cp "$ROOT/aws_lc/build/crypto/libcrypto.a" "$1"
cp "$ROOT/aws_lc/build/ssl/libssl.a" "$2"
